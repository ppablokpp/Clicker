{
  "name": "mobile-capacitor",
  "version": "1.0.0",
  "scripts": {
    "build:web": "npm --prefix ../front run build -- --mode app",
    "sync": "npm run build:web && npx cap sync",
    "sync:live": "npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "run:android": "npx cap run android",
    "run:ios": "npx cap run ios",
    "build:android": "npm run build:web && npx cap sync android && cd android && gradlew bundleRelease",
    "splash": "node scripts/splash.mjs",
    "assets": "node scripts/splash.mjs && capacitor-assets generate --android --ios --iconBackgroundColor \"#120d22\" --iconBackgroundColorDark \"#120d22\" --splashBackgroundColor \"#120d22\" --splashBackgroundColorDark \"#120d22\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "ClankUp native shell (Capacitor) round front/",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-social-login": "^8.5.10",
    "@revenuecat/purchases-capacitor": "^13.6.0"
  },
  "private": true,
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "typescript": "^5.9.3"
  }
}
