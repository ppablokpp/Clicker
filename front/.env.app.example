# Keys for the packaged app (mobile-capacitor/): `vite build --mode app`
# loads this over .env. Copy to .env.app and fill in. All of these are
# public (they ship inside the app bundle either way).
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
VITE_API_URL=https://clicker-api.fly.dev
VITE_REVENUECAT_PUBLIC_KEY=...
# The Google *Web application* OAuth client — the one Clerk's Google
# connection uses as custom credentials. Never the Android client.
VITE_GOOGLE_WEB_CLIENT_ID=....apps.googleusercontent.com
# The iOS OAuth client (type iOS, bundle app.clankup): Google's iOS SDK
# refuses the Web one. Its reversed form is also a URL scheme in the iOS
# Info.plist.
VITE_GOOGLE_IOS_CLIENT_ID=....apps.googleusercontent.com
# RevenueCat "public" keys for the stores the app sells through (the web
# key above stays for the browser). From RevenueCat → project → API keys.
VITE_REVENUECAT_GOOGLE_KEY=goog_...
VITE_REVENUECAT_APPLE_KEY=appl_...

# AdMob rewarded ad units (AdMob → app → Ad units). Safe to set even while
# testing: nothing is served live until VITE_ADMOB_LIVE is 'true'.
VITE_ADMOB_REWARDED_ANDROID=ca-app-pub-..../....
VITE_ADMOB_REWARDED_IOS=ca-app-pub-..../....
# Our own phones, as hashed advertising ids (comma-separated), so that a
# test request still goes to our own ad unit — the only kind with a
# server-side verification URL, and so the only kind that grants a key.
# Google's demo units never call the back. Each id is printed by the SDK on
# the first ad request: adb logcat -s Ads | grep -i setTestDeviceIds
VITE_ADMOB_TEST_DEVICES=ABCDEF0123456789ABCDEF0123456789
# Release day, and only then: real ads, for everyone.
VITE_ADMOB_LIVE=false
# The AdMob *app* ids (with ~) are not here: they live in the native
# projects, android/app/src/main/AndroidManifest.xml and ios Info.plist.
